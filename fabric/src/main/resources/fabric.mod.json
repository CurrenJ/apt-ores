  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "sources": "https://github.com/CurrenJ/apt-ores"
  },
  "license": "${mod_license}",
  "icon": "${mod_icon}",
